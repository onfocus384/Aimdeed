{
  "name": "aimdeed",
  "version": "2.0.0",
  "description": "Aimdeed - NEET & JEE preparation platform (REST API + React SPA)",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "start": "concurrently -n backend,frontend -c blue,magenta \"npm run start:backend\" \"npm run dev --prefix frontend\"",
    "test": "npm test --prefix backend",
    "test:unit": "npm run test:unit --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "test:e2e": "npm run test:e2e --prefix backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pijush008/Aimdeed.git"
  },
  "bugs": {
    "url": "https://github.com/pijush008/Aimdeed/issues"
  },
  "homepage": "https://github.com/pijush008/Aimdeed#readme"
}
