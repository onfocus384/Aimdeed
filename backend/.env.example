# =====================================================================
# Aimdeed backend environment — TEMPLATE
# Copy to .env (development) or .env.production (docker) and fill in real values.
# NEVER commit the real .env files.
# =====================================================================

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend (CORS allow-list is derived from FRONTEND_URL / CORS_ORIGINS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (Database + Auth)
# Find these in your Supabase project dashboard: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Redis (cache + rate limiting — backend only, never exposed to the browser)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
REDIS_PREFIX=aimdeed

# Email Details (For Contact Forms)
# Use a Gmail account with an "App Password"
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM=Aimdeed <your.email@gmail.com>
CONTACT_TO=onfocus384@gmail.com

# Artificial Intelligence (Chatbot)
# OPENROUTER_API_KEY=sk-or-v1-...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...

# Payments
UPI_ID=your_merchant_upi_id@bank
