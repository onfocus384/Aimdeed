<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>
    <%= typeof title !== "undefined"
        ? title
        : "Aimdeed | Best NEET & JEE Preparation Platform" %>
  </title>

  <meta 
    name="description"
    content="<%= typeof description !== 'undefined'
      ? description
      : 'Aimdeed is the ultimate platform for NEET and JEE preparation. Expert mentorship, real success outcomes, and premium study materials for modern students.' %>"
  >
  <meta name="keywords" content="Aimdeed, aimdeed, aimdeed.in, aimdeed.com, NEET preparation, JEE preparation, IIT, medical entrance exams, online coaching, aimdeed study materials, JEE coaching aimdeed">
  <meta name="author" content="Aimdeed">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %>/">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Aimdeed | Best NEET & JEE Preparation Platform' %>">
  <meta property="og:description" content="Aimdeed is the ultimate platform for NEET & JEE preparation with premium materials and mentors.">
  <meta property="og:image" content="https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %>/images/logo_circular.png">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %>/">
  <meta property="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Aimdeed | Best NEET & JEE Preparation Platform' %>">
  <meta property="twitter:description" content="Aimdeed is the ultimate platform for NEET & JEE preparation.">
  <meta property="twitter:image" content="https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %>/images/logo_circular.png">

  <link rel="canonical" href="https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">
  
  <!-- Structured Data (JSON-LD) for SEO Branding -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Aimdeed",
    "alternateName": ["aimdeed.in", "aimdeed.com", "Aim Deed"],
    "url": "https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %>",
    "logo": "https://<%= typeof currentHost !== 'undefined' ? currentHost : 'www.aimdeed.in' %>/images/logo_circular.png",
    "sameAs": [
      "https://www.facebook.com/people/Aim-Deed/pfbid027eQwMFMRqbEDE8ptHYTcEKRJdNAZ1aXywE2dZrncJgXam36mmLXoXvDG39yfwQ6xl/"
    ],
    "description": "Aimdeed is India's leading platform for focused NEET and JEE preparation, connecting students with dedicated mentorship, study materials, and ranking tools."
  }
  </script>
  
  <!-- Primary favicon -->
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css">
  
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

  <!-- Custom Theme -->
  <link rel="stylesheet" href="/css/theme.css">
</head>

<body>
  <%- include('../partials/navbar') %>
  
  <%- include('../partials/flash') %>
  <%- body %>
  
  <%- include('../partials/footer') %>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
