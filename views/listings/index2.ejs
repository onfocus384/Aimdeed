/* Text Box */
.textbox {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 10px 20px;
  border-radius: 5px;
  text-align: center;
  width: 80%;
  font-size: 1.2rem;
}

/* Animation */
@keyframes slide {
  0% {
    transform: translateX(0%);
