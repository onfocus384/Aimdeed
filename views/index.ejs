            <p class="muted">Have questions? We'd love to hear from you.</p>
          </div>

         <form
  id="contact-form"
  class="contact-form"
  method="POST"
  action="/contact"
  autocomplete="off"
>

            <div class="two-cols">
              <div class="input-wrap">
                <i class="fa fa-user icon-left"></i>
                <input class="input" placeholder="Your Name" name="name" />
              </div>
              <div class="input-wrap">
                <i class="fa fa-envelope icon-left"></i>
                <input class="input" type="email" placeholder="Your Email" name="email" />
              </div>
            </div>

            <div class="input-wrap">
              <i class="fa fa-edit icon-left top"></i>
