{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aimdeed-71ub.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://aimdeed-71ub.onrender.com/images/:path*"
    },
    {
      "source": "/people/:path*",
      "destination": "https://aimdeed-71ub.onrender.com/people/:path*"
    },
    {
      "source": "/Books/:path*",
      "destination": "https://aimdeed-71ub.onrender.com/Books/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "https://aimdeed-71ub.onrender.com/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "https://aimdeed-71ub.onrender.com/js/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "https://aimdeed-71ub.onrender.com/favicon.ico"
    },
    {
      "source": "/robots.txt",
      "destination": "https://aimdeed-71ub.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://aimdeed-71ub.onrender.com/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
