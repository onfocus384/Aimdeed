# ---------- Stage 1: Build React SPA ----------
FROM node:22-alpine AS frontend-build

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ .
RUN npm run build

# ---------- Stage 2: Nginx reverse proxy + static files ----------
FROM nginx:1.27-alpine

# Config: reverse proxy, load balancing, rate limiting, caching
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf

# Built SPA (frontend/dist) — html, JS/CSS bundles, public/ assets
COPY --from=frontend-build /app/frontend/dist /usr/share/nginx/html/

# Heavy static assets (images, people, Books, css, js) from backend/public
COPY backend/public/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
