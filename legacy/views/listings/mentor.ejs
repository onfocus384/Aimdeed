<% layout("layouts/boilerplate") %>

<div class="page-hero">
  <div class="container">
    <div class="badge-premium mb-3">Expert Guidance</div>
    <h1 class="page-title">Get a Personal Mentor</h1>
    <p class="page-subtitle">Ready to excel? Fill out the form below and we'll match you with the perfect mentor for your journey.</p>
  </div>
</div>

<div class="container mb-5 pb-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="glass-card p-5">
        <form id="form" method="post" class="row g-4">
          <div class="col-md-6">
            <label class="form-label-premium">Full Name</label>
            <input type="text" class="form-control form-control-glass" id="name" name="name" placeholder="Enter your name" required>
          </div>
          
          <div class="col-md-6">
            <label class="form-label-premium">Gender</label>
            <select class="form-select form-control-glass" id="gender" name="gender" style="color: #000; background-color: #fff;">
              <option value="Male" style="color: #000; background: #fff;">Male</option>
              <option value="Female" style="color: #000; background: #fff;">Female</option>
              <option value="Other" style="color: #000; background: #fff;">Other</option>
            </select>
          </div>
          
          <div class="col-md-6">
            <label class="form-label-premium">Email Address</label>
            <input type="email" class="form-control form-control-glass" id="email" name="email" placeholder="example@email.com" required>
          </div>
          
          <div class="col-md-6">
            <label class="form-label-premium">Contact Number</label>
            <input type="tel" class="form-control form-control-glass" id="phone" name="phone" placeholder="+91 00000 00000" required>
          </div>
          
          <div class="col-md-8">
            <label class="form-label-premium">School Name</label>
            <input type="text" class="form-control form-control-glass" id="school" name="school" placeholder="Enter your school name" required>
          </div>
          
          <div class="col-md-4">
            <label class="form-label-premium">Class</label>
            <input type="number" class="form-control form-control-glass" id="class" name="class" min="1" max="12" placeholder="e.g. 11" required>
          </div>
          
          <div class="col-md-4">
            <label class="form-label-premium">Village / City</label>
            <input type="text" class="form-control form-control-glass" id="city" name="city" placeholder="e.g. Kharagpur" required>
          </div>
          
          <div class="col-md-4">
            <label class="form-label-premium">District</label>
            <input type="text" class="form-control form-control-glass" id="district" name="district" placeholder="District name" required>
          </div>
          
          <div class="col-md-4">
            <label class="form-label-premium">State</label>
            <input type="text" class="form-control form-control-glass" id="state" name="state" placeholder="State" required>
          </div>
          
          <div class="col-12">
            <label class="form-label-premium">What is your future career goal?</label>
            <textarea class="form-control form-control-glass" id="career-goal" name="career_goal" rows="2" placeholder="Tell us about your dreams..." required></textarea>
          </div>
          
          <div class="col-md-6">
            <label class="form-label-premium">Study Hours Daily</label>
            <select class="form-select form-control-glass" id="study-time" name="study_time" style="color: #000; background-color: #fff;">
              <option value="Less than 2 hours" style="color: #000; background: #fff;">Less than 2 hours</option>
              <option value="2-4 hours" style="color: #000; background: #fff;">2-4 hours</option>
              <option value="4-8 hours" style="color: #000; background: #fff;">4-8 hours</option>
              <option value="More than 8 hours" style="color: #000; background: #fff;">More than 8 hours</option>
            </select>
          </div>
          
          <div class="col-md-6">
            <label class="form-label-premium">Why did you choose us?</label>
            <input type="text" class="form-control form-control-glass" id="reason" name="reason" placeholder="e.g. Referral, Social Media..." required>
          </div>

          <div class="col-12 text-center mt-5">
            <div id="res" style="color: #4ade80; font-size: 1rem; font-weight: 600; margin-bottom: 1rem;"></div>
            <button class="btn-premium px-5 py-3" name="btn" type="submit">
              Submit My Application <i class="ri-send-plane-fill ms-2"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/mentor.js"></script>