      <!-- Rank Predictor -->
      <div class="col-md-6 col-lg-3">
        <a href="/predictor" class="r-card-modern">
          <div class="r-icon orange">
            <i class="ri-ruler-2-line"></i>
          </div>
          <h3 class="r-title">Rank Predictor</h3>
          <p class="r-desc">Estimate your JEE rank precisely based on your session scores.</p>
        </a>
      </div>

      <!-- AI Chatbot -->
      <div class="col-md-6 col-lg-3">
        <a href="/chatbot" class="r-card-modern">
          <div class="r-icon indigo">
            <i class="ri-robot-2-line"></i>
          </div>
          <h3 class="r-title">AI Assistant</h3>
          <p class="r-desc">24/7 support for your instant academic and technical doubts.</p>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- INFINITE SLIDER SECTION -->
<section class="slider-container my-5">
  <div class="slider-track">
    <!-- Duplicate elements to create seamless infinity scroll -->
    <% const slides = [
      { img: 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=2070&auto=format&fit=crop', text: 'Your future is created by what you do today.' },
      { img: 'https://images.unsplash.com/photo-1497633762265-9d179a990aa6?q=80&w=1173&auto=format&fit=crop', text: 'Success is not final, failure is not fatal.' },
      { img: 'https://images.unsplash.com/photo-1515378791036-0648a3ef77b2?q=80&w=2070&auto=format&fit=crop', text: 'Dream big, work hard, stay consistent.' },
      { img: 'https://images.unsplash.com/photo-1547637589-f54c34f5d7a4?q=80&w=2070&auto=format&fit=crop', text: 'Believe in yourself and your abilities.' },
      { img: 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=2070&auto=format&fit=crop', text: 'Every step brings you closer to your goals.' },
      { img: 'https://images.unsplash.com/photo-1677567996070-68fa4181775a?q=80&w=1172&auto=format&fit=crop', text: "Opportunities don't happen, you create them." }
    ] %>
    
    <% for(let i=0; i<2; i++) { %>
      <% slides.forEach(slide => { %>
        <div class="slider-item">
          <img src="<%= slide.img %>" alt="Motivation">
          <div class="slider-overlay">
            <div class="slider-text"><%= slide.text %></div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- VIDEO & MOTIVATION SECTION -->
<section class="video-section">
  <div class="container">
    <div class="row g-5 align-items-stretch">
      <div class="col-lg-7">
        <div class="video-wrapper">
          <video autoplay loop muted playsinline>
            <source src="/images/coverVideo.mp4" type="video/mp4">
            <!-- Fallback image if video fails -->
            <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=2070&auto=format&fit=crop" alt="Study Video" style="width:100%; height:100%; object-fit:cover;">
          </video>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="quote-glass">
          <div class="about-badge mb-4" style="align-self: flex-start; background: rgba(14, 165, 233, 0.2); color: #38bdf8; border-color: rgba(14, 165, 233, 0.3);">Daily Motivation</div>
          <h4>"If you think yourselves strong, strong you will be!"</h4>
          <p class="quote-author mb-5 text-muted fst-italic fs-5">— Swami Vivekananda</p>
          <a href="/mentor" class="btn-primary-glow" style="align-self: flex-start;">
            <i class="ri-user-star-line fs-5"></i> Connect with a Mentor
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT US MODERNIZED -->
<section class="about-section" id="about">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 order-lg-2">
        <div class="about-img-container shadow-lg">
          <img src="https://images.unsplash.com/photo-1611743503489-09f50e0be8e4?q=80&w=2159&auto=format&fit=crop" alt="Students studying">
          <!-- Glass overlay element for aesthetic -->
          <div style="position:absolute; bottom:20px; right:20px; background:rgba(255,255,255,0.1); backdrop-filter:blur(10px); padding:1rem 2rem; border-radius:16px; border:1px solid rgba(255,255,255,0.2);">
            <div class="fs-4 fw-bold text-white mb-0">10k+</div>
            <div class="text-white-50 small">Active Students</div>
          </div>
        </div>
      </div>

      <div class="col-lg-6 order-lg-1">
        <div class="about-content">
          <div class="about-badge">Our Story</div>
          
          <h3>Who We Are</h3>
          <p>
            Aimdeed is a student-centric platform dedicated to empowering the next generation of engineers and medical professionals. Founded by top educators and former rankers, we provide high-quality practice resources and personalized mentorship to help you excel.
          </p>

          <h3>Our Mission</h3>
          <p>
            We believe that financial barriers shouldn't hinder brilliant minds. Our mission is to democratize education by offering premium resources accessible to everyone. We invite you to join our growing community of achievers.
          </p>

          <h3>Our Vision</h3>
          <p class="mb-0">
            A world where every student has the guidance they need to succeed. We envision a future where your potential dictates your trajectory, not your circumstances. Let's aim high, together.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple Typewriter Effect
  document.addEventListener("DOMContentLoaded", function() {
    const text = "Your Ultimate Guide to NEET & JEE Success!";
    const speed = 100;
    let i = 0;
    const target = document.getElementById("typewriter-text");
    
    function typeWriter() {
      if (i < text.length) {
        target.innerHTML += text.charAt(i);
        i++;
        setTimeout(typeWriter, speed);
      }
    }
    
    setTimeout(typeWriter, 500); // initial delay
  });
  
  // Apply a scroll effect to navbar if we have one (usually controlled globally, but can help)
  window.addEventListener('scroll', function() {
    const nav = document.querySelector('.navbar');
    if (nav) {
      if (window.scrollY > 50) {
        nav.style.backgroundColor = 'rgba(15, 23, 42, 0.9)';
        nav.style.backdropFilter = 'blur(10px)';
        nav.style.boxShadow = '0 4px 30px rgba(0, 0, 0, 0.1)';
      } else {
        nav.style.backgroundColor = 'transparent';
        nav.style.backdropFilter = 'none';
        nav.style.boxShadow = 'none';
      }
    }
  });
</script>
