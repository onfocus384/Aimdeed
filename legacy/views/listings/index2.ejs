<% layout('layouts/boilerplate') %>
<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

:root {
  --primary: #4F46E5;
  --primary-dark: #3730A3;
  --secondary: #0ea5e9;
  --bg-gradient: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-border: rgba(255, 255, 255, 0.1);
  --text-light: #F8FAFC;
  --text-muted: #94A3B8;
}

body {
  font-family: 'Outfit', sans-serif;
  background-color: #0f172a; /* Slate 900 */
  color: var(--text-light);
  overflow-x: hidden;
}

/* Navbar overrides if any needed (navbar already exists, hopefully it handles transparent bg well) */

/* Hero Section */
.hero-section {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background: radial-gradient(circle at 50% 50%, #1e293b 0%, #0f172a 100%);
  overflow: hidden;
  padding-top: 80px;
}

.hero-blob {
  position: absolute;
  filter: blur(80px);
  z-index: 0;
  border-radius: 50%;
  animation: float 10s ease-in-out infinite alternate;
}

.blob-1 { top: -10%; left: -10%; width: 400px; height: 400px; background: rgba(79, 70, 229, 0.3); }
.blob-2 { bottom: -10%; right: -10%; width: 500px; height: 500px; background: rgba(14, 165, 233, 0.2); animation-delay: -5s; }

@keyframes float {
  0% { transform: translateY(0) scale(1); }
  100% { transform: translateY(-30px) scale(1.1); }
}

.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.hero-title {
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 800;
  line-height: 1.1;
  background: linear-gradient(to right, #a5b4fc, #38bdf8, #818cf8);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 1.5rem;
}

.hero-subtitle {
  font-size: 1.25rem;
  color: var(--text-muted);
  max-width: 600px;
  margin: 0 auto 2.5rem;
  line-height: 1.6;
}

.btn-primary-glow {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  border: none;
  padding: 1rem 2.5rem;
  font-size: 1.1rem;
  font-weight: 600;
  border-radius: 50px;
  transition: all 0.3s ease;
  box-shadow: 0 10px 20px -10px var(--secondary);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary-glow:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 25px -10px var(--secondary);
  color: white;
}

.btn-outline-glow {
  background: transparent;
  color: white;
  border: 2px solid rgba(255, 255, 255, 0.2);
  padding: 1rem 2.5rem;
  font-size: 1.1rem;
  font-weight: 600;
  border-radius: 50px;
  transition: all 0.3s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-outline-glow:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
  color: white;
}

/* Resources Grid */
.resources-section {
  padding: 6rem 0;
  position: relative;
  z-index: 2;
}

.section-title {
  text-align: center;
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: white;
}

.section-subtitle {
  text-align: center;
  color: var(--text-muted);
  margin-bottom: 4rem;
  font-size: 1.1rem;
}

.r-card-modern {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  padding: 2rem;
  text-align: left;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  position: relative;
  overflow: hidden;
  height: 100%;
  display: block;
  text-decoration: none;
  color: white;
  backdrop-filter: blur(10px);
}

.r-card-modern::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.r-card-modern:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 40px -15px rgba(0,0,0,0.5);
  border-color: rgba(255,255,255,0.3);
  color: white;
}

.r-card-modern:hover::before {
  opacity: 1;
}

.r-icon {
  width: 60px;
  height: 60px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  margin-bottom: 1.5rem;
  position: relative;
  z-index: 1;
}

.r-icon.blue { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
.r-icon.purple { background: rgba(168, 85, 247, 0.2); color: #c084fc; }
.r-icon.teal { background: rgba(20, 184, 166, 0.2); color: #2dd4bf; }
.r-icon.green { background: rgba(34, 197, 94, 0.2); color: #4ade80; }
.r-icon.orange { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
.r-icon.indigo { background: rgba(79, 70, 229, 0.2); color: #818cf8; }

.r-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  position: relative;
  z-index: 1;
}

.r-desc {
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.5;
  margin: 0;
  position: relative;
  z-index: 1;
}

.r-img-bg {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.1;
  transition: opacity 0.4s ease;
  z-index: 0;
}
.r-card-modern:hover .r-img-bg {
  opacity: 0.2;
}

/* Infinity Slider */
.slider-container {
  overflow: hidden;
  white-space: nowrap;
  position: relative;
  padding: 2rem 0;
  background: rgba(0,0,0,0.2);
  border-top: 1px solid var(--glass-border);
  border-bottom: 1px solid var(--glass-border);
}

.slider-track {
  display: inline-block;
  animation: scroll 30s linear infinite;
}

.slider-container:hover .slider-track {
  animation-play-state: paused;
}

@keyframes scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.slider-item {
  display: inline-block;
  width: 300px;
  height: 200px;
  margin: 0 1rem;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
}

.slider-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.slider-item:hover img {
  transform: scale(1.1);
}

.slider-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  display: flex;
  align-items: flex-end;
  padding: 1.5rem;
}

.slider-text {
  color: white;
  font-size: 1rem;
  font-weight: 600;
  white-space: normal;
  line-height: 1.4;
}

/* Video Section */
.video-section {
  padding: 6rem 0;
  position: relative;
}

.video-wrapper {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
  border: 1px solid rgba(255,255,255,0.1);
}

.video-wrapper::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24px;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
  pointer-events: none;
}

.video-wrapper video {
  width: 100%;
  display: block;
}

.quote-glass {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 3rem;
  border-radius: 24px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.quote-glass h4 {
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 1rem;
  background: linear-gradient(to right, #fff, #94A3B8);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* About Us */
.about-section {
  padding: 6rem 0;
  position: relative;
}

.about-img-container {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
}

.about-img-container img {
  width: 100%;
  height: 600px;
  object-fit: cover;
  border-radius: 24px;
}

.about-badge {
  display: inline-block;
  padding: 0.5rem 1rem;
  background: rgba(79, 70, 229, 0.2);
  color: #818cf8;
  border-radius: 50px;
  font-weight: 600;
  font-size: 0.9rem;
  margin-bottom: 1.5rem;
  border: 1px solid rgba(79, 70, 229, 0.3);
}

.about-content h3 {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: white;
}

.about-content p {
  color: var(--text-muted);
  font-size: 1.1rem;
  line-height: 1.7;
  margin-bottom: 2rem;
}

/* Typwriter cursor animation */
.typewriter-cursor {
  display: inline-block;
  width: 4px;
  height: 1em;
  background-color: #38bdf8;
  margin-left: 5px;
  vertical-align: middle;
  animation: blink 1s step-end infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}
</style>

<div class="hero-blob blob-1"></div>
<div class="hero-blob blob-2"></div>

<!-- HERO SECTION -->
<section class="hero-section">
  <div class="container hero-content">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="about-badge mb-4"> Elevate Your Preparation</div>
        <h1 class="hero-title">
          <span id="typewriter-text"></span><span class="typewriter-cursor"></span>
        </h1>
        <p class="hero-subtitle">
          Master your exams with our premium study materials, expertly crafted mock tests, and comprehensive past year questions designed for top achievers.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
          <a href="#resources" class="btn-primary-glow">
            Explore Materials <i class="ri-arrow-right-line"></i>
          </a>
          <a href="/login" class="btn-outline-glow">
            Start Free Trial <i class="ri-play-fill"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- RESOURCES SECTION -->
<section class="resources-section" id="resources">
  <div class="container">
    <h2 class="section-title">Everything You Need</h2>
    <p class="section-subtitle">A complete ecosystem for your competitive exam journey.</p>
    
    <div class="row g-4">
      <!-- Notes -->
      <div class="col-md-6 col-lg-3">
        <a href="/student" class="r-card-modern">
          <img src="/images/2840443.jpg" alt="Notes Background" class="r-img-bg">
          <div class="r-icon blue">
            <i class="ri-book-open-line"></i>
          </div>
          <h3 class="r-title">Premium Notes</h3>
          <p class="r-desc">Structured, easy-to-understand notes curated by top faculty.</p>
        </a>
      </div>

      <!-- Tests -->
      <div class="col-md-6 col-lg-3">
        <a href="#" class="r-card-modern">
          <img src="/images/2011.i518.015.realistic test paper pencil.jpg" alt="Tests Background" class="r-img-bg">
          <div class="r-icon teal">
            <i class="ri-edit-box-line"></i>
          </div>
          <h3 class="r-title">Mock Tests</h3>
          <p class="r-desc">Simulated exam environment with detailed performance analytics.</p>
        </a>
      </div>

      <!-- PYQS -->
      <div class="col-md-6 col-lg-3">
        <a href="#" class="r-card-modern">
          <img src="/images/8282.jpg" alt="PYQs Background" class="r-img-bg">
          <div class="r-icon purple">
            <i class="ri-history-line"></i>
          </div>
          <h3 class="r-title">PYQ Archive</h3>
          <p class="r-desc">Years of past questions with step-by-step video solutions.</p>
        </a>
      </div>

      <!-- Mentorship -->
      <div class="col-md-6 col-lg-3">
        <a href="/mentor" class="r-card-modern">
          <div class="r-icon green">
            <i class="ri-user-star-line"></i>
          </div>
          <h3 class="r-title">Mentorship</h3>
          <p class="r-desc">1-on-1 guidance from students who recently cracked the exams.</p>
        </a>
