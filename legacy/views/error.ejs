<% layout("layouts/boilerplate") %>

<div class="page-hero" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="glass-card text-center p-5">
          <div class="rounded-circle mb-4 mx-auto d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; background: rgba(239, 68, 68, 0.1); border: 2px solid rgba(239, 68, 68, 0.3);">
            <i class="ri-error-warning-fill text-danger fs-1"></i>
          </div>
          
          <div class="badge-premium mb-3 border-danger text-danger">Wait, Something Went Wrong</div>
          <h1 class="page-title mb-3"><%= title || 'Error' %></h1>
          <p class="page-subtitle text-muted mb-5 mx-auto" style="max-width: 500px;">
            <%= message || "We couldn't find the page you were looking for. It might have been moved or doesn't exist anymore." %>
          </p>
          
          <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/" class="btn-premium px-4 py-3">
              <i class="ri-home-4-line me-2"></i> Return to Homepage
            </a>
            <a href="javascript:history.back()" class="btn-premium btn-outline-premium px-4 py-3">
              <i class="ri-arrow-left-line me-2"></i> Go Back
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>