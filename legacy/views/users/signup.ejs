<% layout("layouts/boilerplate") %>

<div class="page-hero" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 4rem 1rem;">
  <div class="glass-card p-5" style="width: 100%; max-width: 600px;">
    <div class="text-center mb-5">
      <div class="badge-premium mb-3">Join the Community</div>
      <h1 class="page-title fs-2 mb-2">Create Account</h1>
      <p class="text-muted">Start your journey towards NEET & JEE success with Aimdeed.</p>
    </div>
    
    <form action="/signup" method="POST" class="row g-4">
      <div class="col-md-6">
        <label class="form-label-premium">First Name</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--glass-border); color: var(--text-muted);">
            <i class="ri-user-smile-line"></i>
          </span>
          <input type="text" class="form-control form-control-glass border-start-0" name="firstName" placeholder="John" required>
        </div>
      </div>
      
      <div class="col-md-6">
        <label class="form-label-premium">Last Name</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--glass-border); color: var(--text-muted);">
            <i class="ri-user-smile-line"></i>
          </span>
          <input type="text" class="form-control form-control-glass border-start-0" name="lastName" placeholder="Doe" required>
        </div>
      </div>
      
      <div class="col-12">
        <label class="form-label-premium">Username</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--glass-border); color: var(--text-muted);">
            <i class="ri-at-line"></i>
          </span>
          <input type="text" class="form-control form-control-glass border-start-0" name="username" placeholder="johndoe_ranker" required>
        </div>
        <div class="small text-muted mt-2">This will be your unique identification on the platform.</div>
      </div>
      
      <div class="col-12">
        <label class="form-label-premium">Email Address</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--glass-border); color: var(--text-muted);">
            <i class="ri-mail-line"></i>
          </span>
          <input type="email" class="form-control form-control-glass border-start-0" name="email" placeholder="john@example.com" required>
        </div>
      </div>
      
      <div class="col-12">
        <label class="form-label-premium">Password</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--glass-border); color: var(--text-muted);">
            <i class="ri-lock-password-line"></i>
          </span>
          <input type="password" class="form-control form-control-glass border-start-0" name="password" placeholder="••••••••" required>
        </div>
        <div class="small text-muted mt-2">Must be at least 8 characters with a mix of letters and numbers.</div>
      </div>
      
      <div class="col-12">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="terms" required style="background-color: rgba(255,255,255,0.1); border-color: var(--glass-border);">
          <label class="form-check-label text-muted small" for="terms">
            I agree to the <a href="#" class="text-decoration-none" style="color: #818cf8;">Terms & Conditions</a> and <a href="#" class="text-decoration-none" style="color: #818cf8;">Privacy Policy</a>
          </label>
        </div>
      </div>
      
      <div class="col-12 mt-4">
        <button class="btn-premium w-100 justify-content-center py-3" type="submit">
          Create Account <i class="ri-user-add-line ms-2"></i>
        </button>
      </div>

      <div class="col-12 text-center mt-4">
        <div class="d-flex align-items-center mb-4">
          <hr class="flex-grow-1" style="border-color: rgba(255,255,255,0.1);">
          <span class="mx-3 text-muted small px-2">OR</span>
          <hr class="flex-grow-1" style="border-color: rgba(255,255,255,0.1);">
        </div>
        
        <a href="/auth/google" class="btn d-flex align-items-center justify-content-center gap-2 py-3 w-100" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: var(--text-muted); border-radius: 12px; transition: 0.3s; font-weight: 500;">
          <img src="https://img.icons8.com/color/24/000000/google-logo.png" alt="Google">
          Sign up with Google
        </a>
      </div>
      
      <div class="col-12 text-center mt-4">
        <p class="text-muted small">
          Already have an account? <a href="/login" class="fw-bold text-decoration-none" style="color: #38bdf8;">Log in here</a>
        </p>
      </div>
    </form>
  </div>
</div>