<% layout("layouts/boilerplate") %>

<div class="page-hero">
  <div class="container">
    <div class="badge-premium mb-3">Premium Access</div>
    <h1 class="page-title">Unlock Your Potential</h1>
    <p class="page-subtitle">Choose a plan that fits your preparation needs and get started today.</p>
  </div>
</div>

<div class="container mb-5 pb-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="glass-card p-5">
        <div class="text-center mb-5">
          <h2 class="fs-3 fw-bold mb-2">Aimdeed Payments</h2>
          <p class="text-muted small">Secure & Instant Verification</p>
        </div>

        <!-- STEP 1: AMOUNT SELECTION -->
        <div id="amountSection">
          <label class="form-label-premium mb-3">Select Subscription Plan</label>
          <div class="row g-3 mb-5">
            <% allowedAmounts.forEach(amt => { %>
              <div class="col-4">
                <div class="amount-option text-center" data-amount="<%= amt %>" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: 16px; padding: 1.5rem 0.5rem; cursor: pointer; transition: all 0.3s ease;">
                  <div class="small text-muted mb-1">INR</div>
                  <div class="fs-3 fw-bold" style="color: var(--text-light);">₹<%= amt %></div>
                </div>
              </div>
            <% }) %>
          </div>

          <button id="proceedBtn" class="btn-premium w-100 justify-content-center py-3" disabled>
            Proceed to Checkout (₹<span id="selectedAmount">0</span>) <i class="ri-arrow-right-line ms-2"></i>
          </button>
        </div>

        <!-- STEP 2: QR & CONFIRMATION -->
        <div id="qrSection" style="display: none;">
          <div class="text-center mb-4 p-4 rounded-4" style="background: var(--gradient-primary);">
            <div class="small opacity-75">Total Payable Amount</div>
            <div class="fs-1 fw-800" id="qrAmount">₹0</div>
          </div>

          <div class="text-center p-4 mb-4 rounded-4" style="background: white; border: 8px solid rgba(255,255,255,0.1);">
            <img id="qrImage" class="img-fluid" style="max-height: 250px;" alt="Scan to Pay">
          </div>

          <form action="/payment/confirm" method="POST" class="row g-4">
            <input type="hidden" name="amount" id="finalAmount">
            
            <div class="col-12">
              <label class="form-label-premium">Payer Name</label>
              <input type="text" class="form-control form-control-glass" name="payerName" placeholder="Enter your full name" required>
            </div>

            <div class="col-12">
              <label class="form-label-premium">Transaction ID / UTR</label>
              <input type="text" class="form-control form-control-glass" name="utr" placeholder="Enter 12-digit Transaction ID" required>
            </div>

            <div class="col-12 mt-5">
              <button type="submit" class="btn-premium w-100 justify-content-center py-3">
                Confirm Payment <i class="ri-checkbox-circle-line ms-2"></i>
              </button>
            </div>
          </form>

          <div class="badge-premium bg-opacity-10 text-wrap w-100 mt-4 text-center py-3" style="font-weight: 400; font-size: 0.9rem;">
            <i class="ri-information-line me-1"></i> Payment is manually verified. It usually takes 5-15 minutes to activate your account.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .amount-option.selected {
    background: var(--gradient-primary) !important;
    border-color: transparent !important;
    transform: translateY(-5px);
    box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
  }
  .amount-option.selected div {
    color: white !important;
  }
</style>

<script>
  const options = document.querySelectorAll(".amount-option");
  const proceedBtn = document.getElementById("proceedBtn");
  const selectedAmountSpan = document.getElementById("selectedAmount");

  const amountSection = document.getElementById("amountSection");
  const qrSection = document.getElementById("qrSection");

  const qrAmountDisplay = document.getElementById("qrAmount");
  const qrImage = document.getElementById("qrImage");
  const finalAmount = document.getElementById("finalAmount");

  let selectedAmount = null;

  options.forEach(option => {
    option.onclick = () => {
      options.forEach(o => o.classList.remove("selected"));
      option.classList.add("selected");
      selectedAmount = option.dataset.amount;
      selectedAmountSpan.textContent = selectedAmount;
      proceedBtn.disabled = false;
    };
  });

  proceedBtn.onclick = async () => {
    qrAmountDisplay.textContent = "₹" + selectedAmount;
    finalAmount.value = selectedAmount;

    // Show loading state
    proceedBtn.innerHTML = 'Generating QR... <span class="spinner-border spinner-border-sm ms-2"></span>';
    proceedBtn.disabled = true;

    try {
      const res = await fetch("/payment/generate-qr", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ amount: selectedAmount })
      });

      const data = await res.json();
      if (data.success) {
        qrImage.src = data.qrImage;
        amountSection.style.display = "none";
        qrSection.style.display = "block";
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        alert("Failed to generate QR. Please try again.");
        proceedBtn.innerHTML = 'Proceed to Checkout (₹' + selectedAmount + ') <i class="ri-arrow-right-line ms-2"></i>';
        proceedBtn.disabled = false;
      }
    } catch (err) {
      console.error(err);
      alert("An error occurred. Please check your connection.");
      proceedBtn.disabled = false;
    }
  };
</script>
