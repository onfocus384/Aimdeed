<% layout("layouts/boilerplate") %>

<style>
  .forgot-container {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }
  
  .forgot-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    padding: 2.5rem;
    width: 100%;
    max-width: 450px;
    border: 1px solid #e9ecef;
  }
  
  .forgot-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .forgot-icon {
    background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: white;
    font-size: 2rem;
  }
  
  .forgot-title {
    color: #2c3e50;
    font-weight: 700;
    margin-bottom: 0.75rem;
    font-size: 1.8rem;
  }
  
  .forgot-subtitle {
    color: #6c757d;
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  
  .form-label {
    font-weight: 600;
    color: #495057;
    margin-bottom: 0.5rem;
  }
  
  .form-control {
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    transition: all 0.2s ease;
    width: 100%;
    margin-bottom: 1.5rem;
  }
  
  .form-control:focus {
    border-color: #4dabf7;
    box-shadow: 0 0 0 0.2rem rgba(77, 171, 247, 0.25);
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
    border: none;
    border-radius: 8px;
    padding: 0.875rem 1.5rem;
    font-weight: 600;
    font-size: 1rem;
    width: 100%;
    transition: all 0.3s ease;
    color: white;
    cursor: pointer;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(13, 110, 253, 0.3);
  }
  
  .back-to-login {
    display: block;
    text-align: center;
    margin-top: 1.5rem;
    color: #6c757d;
    text-decoration: none;
  }
  
  .back-to-login:hover {
    color: #0d6efd;
    text-decoration: underline;
  }
</style>

<div class="forgot-container">
  <div class="forgot-card">
    <div class="forgot-header">
      <div class="forgot-icon">
        <i class="bi bi-key-fill"></i>
      </div>
      <h1 class="forgot-title">Reset Your Password</h1>
      <p class="forgot-subtitle">Enter your email address and we'll send you a link to reset your password.</p>
    </div>
    
    <!-- FORM STARTS HERE -->
    <form action="/forgot-password" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input 
          type="email" 
          class="form-control" 
          id="email" 
          name="email"
          placeholder="Enter your registered email"
          required
        >
        <div class="form-text">Enter the email you used during signup.</div>
      </div>
      
      <button type="submit" class="btn btn-primary">
        Send Reset Link
      </button>
      
      <a href="/login" class="back-to-login">
        <i class="bi bi-arrow-left"></i> Back to Login
      </a>
    </form>
    <!-- FORM ENDS HERE -->
  </div>
</div>